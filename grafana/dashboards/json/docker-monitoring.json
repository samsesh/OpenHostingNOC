{
  "apiVersion": 1,
  "id": 4,
  "uid": "opennoc-docker",
  "title": "Docker Monitoring",
  "tags": ["opennoc", "docker"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "count(up{job=\"cadvisor\"} == 1)", "legendFormat": "Running", "refId": "A" }
      ],
      "title": "Running Containers",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 90 } ] },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 3, "w": 5, "x": 4, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "avg(container_last_seen{name!~\"\"})", "legendFormat": "Last Seen", "refId": "A" }
      ],
      "title": "Container Uptime",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 } ] },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 3, "w": 5, "x": 9, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "avg(container_memory_usage_bytes{name!~\"\"} / container_spec_memory_limit_bytes{name!~\"\"} * 100)", "legendFormat": "Memory %", "refId": "A" }
      ],
      "title": "Avg Container Memory",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 } ] },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 3, "w": 5, "x": 14, "y": 0 },
      "id": 5,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "avg(rate(container_cpu_usage_seconds_total{name!~\"\"}[5m])) * 100", "legendFormat": "CPU %", "refId": "A" }
      ],
      "title": "Avg Container CPU",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 } ] },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 3, "w": 5, "x": 19, "y": 0 },
      "id": 6,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "sum(container_memory_usage_bytes{name!~\"\"})", "legendFormat": "Total Memory", "refId": "A" }
      ],
      "title": "Total Container Memory",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{name!~\"\"}[5m]) * 100", "legendFormat": "{{ name }}", "refId": "A" }
      ],
      "title": "Container CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "container_memory_usage_bytes{name!~\"\"}", "legendFormat": "{{ name }}", "refId": "A" }
      ],
      "title": "Container Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(container_network_receive_bytes_total{name!~\"\"}[5m]) * 8", "legendFormat": "RX: {{ name }}", "refId": "A" }
      ],
      "title": "Container Network Receive",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(container_network_transmit_bytes_total{name!~\"\"}[5m]) * 8", "legendFormat": "TX: {{ name }}", "refId": "A" }
      ],
      "title": "Container Network Transmit",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["opennoc", "docker"],
  "templating": {
    "list": []
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "timezone": "browser",
  "title": "Docker Monitoring",
  "uid": "opennoc-docker",
  "version": 1,
  "weekStart": ""
}
