{
  "apiVersion": 1,
  "id": 2,
  "uid": "opennoc-security",
  "title": "Security Dashboard",
  "tags": ["opennoc", "security"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": 1, "options": { "0": { "text": "None", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "count(ALERTS{alertstate=\"firing\",category=\"security\"})", "legendFormat": "Active", "refId": "A" }
      ],
      "title": "Active Security Alerts",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100000 }, { "color": "red", "value": 500000 } ] },
          "unit": "pps"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "max(rate(node_network_receive_packets_total[1m]))", "legendFormat": "Max PPS", "refId": "A" }
      ],
      "title": "Max Packets/sec",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 10000 }, { "color": "red", "value": 50000 } ] },
          "unit": "pps"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "rate(node_netstat_Udp_InDatagrams[1m])", "legendFormat": "UDP Datagrams/sec", "refId": "A" }
      ],
      "title": "UDP Datagrams/sec",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 5,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "rate(node_netstat_Tcp_ListenOverflows[1m])", "legendFormat": "SYN Overflows/sec", "refId": "A" }
      ],
      "title": "SYN Queue Overflows",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 6,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "rate(node_netstat_Tcp_AttemptFails[1m])", "legendFormat": "Failed Attempts/sec", "refId": "A" }
      ],
      "title": "TCP Failed Attempts",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 } ] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 7,
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "showPercentChange": false },
      "targets": [
        { "expr": "node_netstat_IpExt_ListenOverflows", "legendFormat": "Listen Overflows", "refId": "A" }
      ],
      "title": "Connection Table Pressure",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(node_network_receive_packets_total[1m])", "legendFormat": "{{ instance }} - {{ device }}", "refId": "A" }
      ],
      "title": "Packet Rate (PPS)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(node_netstat_Tcp_ListenOverflows[1m])", "legendFormat": "{{ instance }}", "refId": "A" },
        { "expr": "rate(node_netstat_Tcp_AttemptFails[1m])", "legendFormat": "Failed: {{ instance }}", "refId": "B" }
      ],
      "title": "TCP Anomalies",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(node_netstat_Udp_InDatagrams[1m])", "legendFormat": "UDP In: {{ instance }}", "refId": "A" },
        { "expr": "rate(node_netstat_Udp_OutDatagrams[1m])", "legendFormat": "UDP Out: {{ instance }}", "refId": "B" }
      ],
      "title": "UDP Traffic",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(node_netstat_Tcp_CurrEstab[1m])", "legendFormat": "{{ instance }}", "refId": "A" }
      ],
      "title": "TCP Connections",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[1m]) * 8", "legendFormat": "RX: {{ instance }} {{ device }}", "refId": "A" }
      ],
      "title": "Bandwidth (BPS)",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["opennoc", "security"],
  "templating": {
    "list": []
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "15s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "timezone": "browser",
  "title": "Security Dashboard",
  "uid": "opennoc-security",
  "version": 1,
  "weekStart": ""
}
